FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY CuentasPorPagarAPI/CuentasPorPagarAPI/CuentasPorPagarAPI.csproj CuentasPorPagarAPI/CuentasPorPagarAPI/
RUN dotnet restore CuentasPorPagarAPI/CuentasPorPagarAPI/CuentasPorPagarAPI.csproj
COPY CuentasPorPagarAPI/ CuentasPorPagarAPI/
RUN dotnet publish CuentasPorPagarAPI/CuentasPorPagarAPI/CuentasPorPagarAPI.csproj -c Release --no-restore -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://0.0.0.0:10000
EXPOSE 10000
USER $APP_UID
ENTRYPOINT ["dotnet", "CuentasPorPagarAPI.dll"]
